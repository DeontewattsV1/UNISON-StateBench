    {"id": "T_TESTED_TO_APPROVED", "from_invariant": "I_TESTS_PASSED", "to_invariant": "I_APPROVAL_GRANTED", "required_evidence": ["E_RELEASE_APPROVAL"], "observed": false, "minimum_authority_rank": 100, "description": "Passing tests do not imply approval."},
