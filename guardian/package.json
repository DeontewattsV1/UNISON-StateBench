{
  "name": "unison-guardian",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A bounded, reproducible authority and revocation verification sandbox for AI agents.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --use-env-proxy --env-file-if-exists=.env server/index.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node --use-env-proxy --env-file-if-exists=.env server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "build:worker": "npm run build && node scripts/build-worker.mjs",
    "dev:worker": "wrangler dev",
    "test:worker": "node --test worker/*.test.mjs",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.12",
    "miniflare": "5.20261023.2-beta",
    "playwright": "^1.56.0",
    "vite": "^6.4.0",
    "wrangler": "^4.155.0"
  }
}
